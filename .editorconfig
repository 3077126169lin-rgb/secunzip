# https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.{bat,cmd,ps1,iss}]
end_of_line = crlf

# 二进制文件（*.ico、*.png 等）不做任何文本处理，保持原样。
